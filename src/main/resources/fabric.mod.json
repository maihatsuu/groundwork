{
	"schemaVersion": 1,
	"id": "groundwork",
	"version": "${version}",
	"name": "Groundwork",
	"description": "Revert dirt paths and farmland with shovels and hoes, and control farmland trampling and decay with gamerules.",
	"authors": [
		"maihatsuu"
	],
	"contact": {
		"homepage": "https://github.com/maihatsuu/groundwork",
		"sources": "https://github.com/maihatsuu/groundwork"
	},
	"license": "CC0-1.0",
	"icon": "assets/groundwork/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.maihatsuu.groundwork.Groundwork"
		],
		"client": [
			"com.maihatsuu.groundwork.client.GroundworkClient"
		]
	},
	"mixins": [
		"groundwork.mixins.json",
		{
			"config": "groundwork.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*"
	}
}